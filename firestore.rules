rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 相談・応募フォーム：一般ユーザーからの新規投稿（create）のみ許可。閲覧・書き換え・削除は不可
    match /consultations/{document} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    // CMS記事・サイトコンテンツ：読み取り専用。外部からの書き換え（write）は完全禁止
    match /cms/{document} {
      allow read: if true;
      allow write: if false;
    }
    // その他のコレクション：外部からの書き込みは全面拒否
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
