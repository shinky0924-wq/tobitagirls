<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Permanent Redirects for legacy URLs (Soft 404 / Noindex Resolution)
  RewriteRule ^blog/tobitashinchi-dormitory-lifestyle-support/?$ /blog/tobitashinchi-housing-support [R=301,L]
  RewriteRule ^blog/tobitashinchi-tax-declaration-guide/?$ /blog/tobitashinchi-tax-guide [R=301,L]
  RewriteRule ^blog/tobitashinchi-privacy-alibi-support/?$ /blog/tobitashinchi-identity-alibi-safety-measures [R=301,L]
  RewriteRule ^blog/tobitashinchi-physical-mental-care-guide/?$ /blog/tobitashinchi-stamina-mental-care-100k [R=301,L]
  RewriteRule ^blog/tobitashinchi-fake-job-scout-warning/?$ /blog/tobitashinchi-scout-fraud-avoidance-safe-recruitment [R=301,L]
  RewriteRule ^blog/tobitashinchi-daily-work-routine-guide/?$ /blog/tobitashinchi-daily-schedule-work-flow-detail [R=301,L]
  RewriteRule ^blog/tobitashinchi-id-requirements/?$ /blog/tobitashinchi-resident-record-requirement-checklist [R=301,L]
  RewriteRule ^blog/tobitashinchi-merits-and-demerits/?$ /blog/tobitashinchi-merit-demerit-honest [R=301,L]
  RewriteRule ^blog/tobitashinchi-shift-workstyle-guide/?$ /blog/flexible-shift-work-style-guide [R=301,L]
  RewriteRule ^blog/tobitashinchi-safety-rules-faq/?$ /blog/tobita-safe-recruitment [R=301,L]
  RewriteRule ^blog/tobitashinchi-main-vs-seishun-street/?$ /blog/tobita-street-compare [R=301,L]
  RewriteRule ^blog/tobitashinchi-salary-system-breakdown/?$ /blog/tobitashinchi-official-salary-formula-breakdown [R=301,L]
  RewriteRule ^comparison/?$ /compare [R=301,L]
  RewriteRule ^target-categories/?$ /compare [R=301,L]
  RewriteRule ^target-jobs/?$ /compare [R=301,L]
  RewriteRule ^categories/?$ /compare [R=301,L]
  RewriteRule ^company/?$ /about [R=301,L]
  RewriteRule ^dorm/?$ /dekasegi [R=301,L]
  RewriteRule ^compare/inexperienced/?$ /compare/beginner [R=301,L]
  RewriteRule ^compare/weekly-1/?$ /compare/one-day-week [R=301,L]
  RewriteRule ^compare/dormitory/?$ /compare/short-term [R=301,L]
  RewriteRule ^compare/double-work/?$ /compare/office-worker [R=301,L]
  RewriteRule ^compare/age-20s/?$ /compare/20s [R=301,L]
  RewriteRule ^compare/age-30s/?$ /compare/30s [R=301,L]
  RewriteRule ^compare/age-40s/?$ /compare/40s [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteRule . /index.html [L]
</IfModule>
