{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog/tobitashinchi-dormitory-lifestyle-support", "destination": "/blog/tobitashinchi-housing-support", "permanent": true },
    { "source": "/blog/tobitashinchi-tax-declaration-guide", "destination": "/blog/tobitashinchi-tax-guide", "permanent": true },
    { "source": "/blog/tobitashinchi-privacy-alibi-support", "destination": "/blog/tobitashinchi-identity-alibi-safety-measures", "permanent": true },
    { "source": "/blog/tobitashinchi-physical-mental-care-guide", "destination": "/blog/tobitashinchi-stamina-mental-care-100k", "permanent": true },
    { "source": "/blog/tobitashinchi-fake-job-scout-warning", "destination": "/blog/tobitashinchi-scout-fraud-avoidance-safe-recruitment", "permanent": true },
    { "source": "/blog/tobitashinchi-daily-work-routine-guide", "destination": "/blog/tobitashinchi-daily-schedule-work-flow-detail", "permanent": true },
    { "source": "/blog/tobitashinchi-id-requirements", "destination": "/blog/tobitashinchi-resident-record-requirement-checklist", "permanent": true },
    { "source": "/blog/tobitashinchi-merits-and-demerits", "destination": "/blog/tobitashinchi-merit-demerit-honest", "permanent": true },
    { "source": "/blog/tobitashinchi-shift-workstyle-guide", "destination": "/blog/flexible-shift-work-style-guide", "permanent": true },
    { "source": "/blog/tobitashinchi-safety-rules-faq", "destination": "/blog/tobita-safe-recruitment", "permanent": true },
    { "source": "/blog/tobitashinchi-main-vs-seishun-street", "destination": "/blog/tobita-street-compare", "permanent": true },
    { "source": "/blog/tobitashinchi-salary-system-breakdown", "destination": "/blog/tobitashinchi-official-salary-formula-breakdown", "permanent": true },
    { "source": "/comparison", "destination": "/compare", "permanent": true },
    { "source": "/target-categories", "destination": "/compare", "permanent": true },
    { "source": "/target-jobs", "destination": "/compare", "permanent": true },
    { "source": "/categories", "destination": "/compare", "permanent": true },
    { "source": "/company", "destination": "/about", "permanent": true },
    { "source": "/dorm", "destination": "/dekasegi", "permanent": true },
    { "source": "/compare/inexperienced", "destination": "/compare/beginner", "permanent": true },
    { "source": "/compare/weekly-1", "destination": "/compare/one-day-week", "permanent": true },
    { "source": "/compare/dormitory", "destination": "/compare/short-term", "permanent": true },
    { "source": "/compare/double-work", "destination": "/compare/office-worker", "permanent": true },
    { "source": "/compare/age-20s", "destination": "/compare/20s", "permanent": true },
    { "source": "/compare/age-30s", "destination": "/compare/30s", "permanent": true },
    { "source": "/compare/age-40s", "destination": "/compare/40s", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
